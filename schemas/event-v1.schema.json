{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commerce/events/v1",
  "title": "Commerce event v1",
  "type": "object",
  "required": ["schema_version", "event_id", "tenant_id", "market", "event_type", "occurred_at", "payload"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
    "market": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "event_type": {"enum": ["order", "payment", "inventory", "shipment", "application"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "order"}}},
      "then": {"properties": {"payload": {"required": ["order_id", "amount", "currency", "email"], "properties": {"order_id": {"type": "string"}, "amount": {"type": "number", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "email": {"type": "string"}}}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "payment"}}},
      "then": {"properties": {"payload": {"required": ["order_id", "status", "amount"], "properties": {"order_id": {"type": "string"}, "status": {"enum": ["authorized", "captured", "failed", "refunded"]}, "amount": {"type": "number", "minimum": 0}}}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "shipment"}}},
      "then": {"properties": {"payload": {"required": ["order_id", "status", "eta_at"], "properties": {"order_id": {"type": "string"}, "status": {"enum": ["pending", "in_transit", "delayed", "delivered"]}, "eta_at": {"type": "string", "format": "date-time"}}}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "inventory"}}},
      "then": {"properties": {"payload": {"required": ["sku", "available"], "properties": {"sku": {"type": "string"}, "available": {"type": "integer", "minimum": 0}}}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "application"}}},
      "then": {"properties": {"payload": {"required": ["level", "message"], "properties": {"level": {"enum": ["DEBUG", "INFO", "WARN", "ERROR"]}, "message": {"type": "string"}}}}}
    }
  ]
}
