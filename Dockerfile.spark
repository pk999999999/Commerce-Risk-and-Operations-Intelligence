FROM apache/spark:3.5.7-python3
ENV PYTHONPATH=/opt/project
USER root
RUN pip install --no-cache-dir psycopg[binary]==3.2.9 clickhouse-connect==0.8.18 elasticsearch==8.17.2
COPY app /opt/project/app
COPY jobs /opt/project/jobs
RUN mkdir -p /opt/project/lake /opt/project/checkpoints && chown -R spark:spark /opt/project
USER spark
WORKDIR /opt/project
CMD ["/opt/spark/bin/spark-submit", "--master", "local[2]", "--packages", "org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.7", "/opt/project/jobs/stream.py"]
